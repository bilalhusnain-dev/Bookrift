DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/bookrift_db

SECRET_KEY=replace-with-a-long-random-value
ADMIN_EMAIL=admin@bookrift.local
ADMIN_PASSWORD=replace-with-a-strong-password

GOOGLE_BOOKS_API_KEY=
# Blank SMTP_HOST prints signup verification codes only.
# Password reset and password change require SMTP email delivery.
# For Gmail use smtp.gmail.com with port 587 and an app password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Bookrift <no-reply@bookrift.local>

MAX_UPLOAD_MB=10
HOST=127.0.0.1
PORT=5001
FLASK_DEBUG=0
DEV_FRONTEND_ORIGIN=http://127.0.0.1:8080

